<?xml version="1.0" encoding="utf-8"?>
<!-- 2.4 PS overlay (PsService). Key filtering for the PS button, window state changes to know
     which app is in front (package name only). No gestures, no touch exploration. Joystick motion is
     requested at run time, only while the menu is open.
     2.8: canRetrieveWindowContent is on for one job: the experimental FORCE STOP in the task manager,
     which opens the app's App Info page, finds the Force stop button and its confirm button and clicks
     them. The service reads the node tree only during that job (see PsService.forceStop), keeps nothing
     and sends nothing anywhere. The touchpad volume gesture asks for pointer and touchpad motion at run
     time (Android 14 and newer), only while it is switched on in Setup. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/ps_service_desc"
    android:summary="@string/ps_service_summary" />

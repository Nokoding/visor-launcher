<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.nokoding.deck"
    android:versionCode="22"
    android:versionName="2.18-beta">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Read only link type for the status icon. No INTERNET permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Normal permission, needed to open the system uninstall dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- v2: list every installed app with a launch intent (Add app, Show all apps).
         Without it Android 11+ hides packages that lack a launcher category. Not a runtime permission. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- v2: controller rumble. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v2.1: optional recents source "System usage". Not granted at install. The user grants it
         once with: adb shell appops set com.nokoding.deck GET_USAGE_STATS allow
         Without it Deck uses its own launch history. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 2.8: the task manager's KILL BACKGROUND and CLOSE ALL BACKGROUND (ActivityManager.killBackgroundProcesses).
         A normal permission, granted at install. It only reaches cached and background processes, never the
         app on screen. FORCE_STOP_PACKAGES is a signature permission and is not requested. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- 2.15: only for the experimental DECK DISPLAY game profile method. Installing the app does NOT give it: it is a
         protected permission, so nothing happens until the user runs adb shell pm grant com.nokoding.deck
         android.permission.WRITE_SECURE_SETTINGS. It has to be listed here, because pm grant refuses a permission the
         app never asked for (2.8 to 2.14 left it out and the grant failed). Nothing else in Deck uses it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- No android.permission.LIGHTS: it is not defined by the platform (checked in the Android 14
         and main framework manifests), and the InputDevice lights calls have no permission check. -->

    <!-- Android 11+ package visibility: only what a launcher needs. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.INFO" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <package android:name="com.google.android.apps.tv.launcherx" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_deck"
        android:banner="@drawable/banner"
        android:theme="@style/DeckTheme"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:banner="@drawable/banner"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2.4: the PS menu over other apps. Off until the user enables it over adb
             (docs/ps-menu.md). Only the system can bind it: BIND_ACCESSIBILITY_SERVICE is
             held by the system alone, so exporting it exposes nothing to other apps. -->
        <service
            android:name=".PsService"
            android:exported="true"
            android:label="@string/ps_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ps_service" />
        </service>

        <!-- 2.7: Deck's own screensaver (a "dream"). Only the system can bind it: BIND_DREAM_SERVICE is
             held by the system alone, so exporting it exposes nothing to other apps. It does nothing
             until it is chosen as the screensaver (docs/screensaver.md, tools/enable-screensaver.sh).
             No new permission for Deck itself. -->
        <service
            android:name=".DeckDream"
            android:exported="true"
            android:label="@string/dream_label"
            android:icon="@drawable/ic_deck"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/deck_dream" />
        </service>
    </application>
</manifest>
